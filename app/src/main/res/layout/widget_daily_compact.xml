<?xml version="1.0" encoding="utf-8"?>
<!-- Low-height launcher cells keep the add and completion targets at 44dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="NestedWeights"
    android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingVertical="8dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_content" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center_vertical" android:contentDescription="@string/widget_view_plan">
            <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="32sp" android:fontFamily="sans-serif-light" android:textColor="@color/widget_text" android:maxLines="1"
                android:layout_marginEnd="10dp" android:includeFontPadding="false" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/widget_loading" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/widget_add" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginStart="8dp" android:text="@string/widget_add_symbol" android:contentDescription="@string/widget_add" android:textSize="23sp"
            android:gravity="center" android:background="@drawable/widget_add_background" android:textColor="@color/widget_accent" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_progress" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center_vertical" android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_undo" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center"
            android:text="@string/widget_undo" android:textSize="12sp" android:textColor="@color/widget_accent" android:visibility="gone" />
        <TextView android:id="@+id/widget_complete" android:layout_width="wrap_content" android:layout_height="44dp"
            android:minWidth="96dp" android:paddingHorizontal="12dp" android:layout_marginStart="6dp" android:gravity="center"
            android:text="@string/widget_add" android:textSize="13sp" android:maxLines="1"
            android:background="@drawable/widget_button_background" android:textColor="@color/widget_on_accent" />
    </LinearLayout>
</LinearLayout>
